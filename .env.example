# Helios 开发环境变量样例 — 复制为 .env 后按需修改
# 切勿提交真实密钥到仓库

# === API 服务 ===
HELIOS_API_ADDR=:8080
HELIOS_LOG_LEVEL=debug
HELIOS_ENV=dev

# === Dev 容器端口 (默认避开常见占用) ===
HELIOS_PG_PORT=5432
HELIOS_REDIS_PORT=6380          # 避开本机已运行的 redis (默认 6379)
HELIOS_S3_PORT=9000
HELIOS_S3_CONSOLE_PORT=9001
HELIOS_ADMINER_PORT=8082

# === PostgreSQL (开发用,生产请改) ===
HELIOS_DB_DSN=postgres://helios:helios@127.0.0.1:5432/helios?sslmode=disable
HELIOS_DB_USER=helios
HELIOS_DB_PASSWORD=helios
HELIOS_DB_NAME=helios

# === Redis ===
HELIOS_REDIS_ADDR=127.0.0.1:6380
HELIOS_REDIS_DB=0

# === MinIO / S3 ===
HELIOS_S3_ENDPOINT=http://127.0.0.1:9000
HELIOS_S3_ACCESS_KEY=admin
HELIOS_S3_SECRET_KEY=admin12345
HELIOS_S3_BUCKET_ARTIFACTS=helios-artifacts
HELIOS_S3_BUCKET_LOGS=helios-logs
HELIOS_S3_BUCKET_AUDIT=helios-audit

# === JWT (开发用,生产请用 KMS) ===
HELIOS_JWT_PRIVATE_KEY_PATH=./.helios/jwt-private.pem
HELIOS_JWT_PUBLIC_KEY_PATH=./.helios/jwt-public.pem
HELIOS_JWT_ISSUER=helios-dev
HELIOS_JWT_ACCESS_TTL=30m
HELIOS_JWT_REFRESH_TTL=168h

# === Web ===
NEXT_PUBLIC_API_BASE=http://localhost:8080
